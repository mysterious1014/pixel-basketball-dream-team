/* pages/collection/collection.wxss —— 图鉴网格（3 列，硬边稀有度描边，未获得 = 剪影） */
.cl-hero { display: flex; align-items: baseline; gap: 12rpx; }
.cl-rar { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cl-rar-item { display: flex; align-items: center; gap: 6rpx; }
.cl-fic { display: block; margin-top: 10rpx; }

.cl-flabel { margin-bottom: 8rpx; }
.cl-chip { height: 44rpx; padding: 0 14rpx; font-size: 20rpx; }

.cl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.cl-cell { position: relative; }
.cl-frame {
  position: relative; display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  padding: 10rpx 8rpx 12rpx; background: var(--navy800);
  border: 4rpx solid var(--rc, var(--line));
  box-shadow: 0 6rpx 0 0 rgba(0,0,0,0.45), inset 0 0 0 2rpx var(--line-soft);
}
.cl-frame--lock { border-color: var(--line-soft); opacity: 0.62; }
.cl-top { display: flex; align-items: baseline; justify-content: space-between; width: 100%; }
.cl-ovr { font-size: 28rpx; font-weight: bold; }
.cl-rar { font-size: 18rpx; letter-spacing: 1rpx; }
.cl-name { width: 100%; text-align: center; font-size: 22rpx; color: var(--text); }
.cl-meta { font-size: 16rpx; color: var(--text-mute); }
.cl-count {
  position: absolute; right: 6rpx; bottom: 6rpx; padding: 0 8rpx;
  font-size: 18rpx; color: var(--navy900); background: var(--gold);
}
.cl-legal { padding: 12rpx; text-align: center; }